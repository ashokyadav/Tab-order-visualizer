{
  "manifest_version": 3,
  "name": "Tab Order Visualizer",
  "version": "1.0.0",
  "description": "By Ashok Kumar Yadav. See the keyboard tab order on any page and spot focus jumps, hidden focus and missing focus styles.",
  "homepage_url": "https://www.linkedin.com/in/ashokkumaryadav",
  "action": {
    "default_title": "Tab Order Visualizer by Ashok Kumar Yadav (Alt+Shift+T)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Toggle the Tab Order Visualizer"
    }
  }
}
